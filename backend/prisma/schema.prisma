// Distac / Prottus base — Prisma schema (PostgreSQL)
// Code/persistence in English; UI labels in Portuguese.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 6: URL fica no schema (correto neste projeto).
  // Se o editor marcar erro vermelho, ative "Prisma: Pin to Prisma 6"
  // (extensão Prisma 7 valida regras da v7 por padrão).
  url = env("DATABASE_URL")
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  orders       Order[]

  @@map("users")
}

model Client {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  document  String   @unique
  phone     String?
  email     String?
  city      String?
  state     String?  @db.VarChar(2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  orders    Order[]

  @@map("clients")
}

model Product {
  id         String      @id @default(uuid()) @db.Uuid
  sku        String      @unique
  name       String
  unit       String
  price      Decimal     @db.Decimal(12, 2)
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  orderItems OrderItem[]

  @@map("products")
}

model Order {
  id        String      @id @default(uuid()) @db.Uuid
  number    String      @unique
  clientId  String      @map("client_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  status    OrderStatus @default(DRAFT)
  /// Owned by PostgreSQL triggers — do not trust API-written values.
  total     Decimal     @default(0) @db.Decimal(14, 2)
  notes     String?
  orderedAt DateTime    @default(now()) @map("ordered_at") @db.Timestamptz
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  client    Client      @relation(fields: [clientId], references: [id])
  user      User        @relation(fields: [userId], references: [id])
  items     OrderItem[]

  @@index([clientId])
  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  /// Owned by BEFORE trigger on order_items.
  lineTotal Decimal @map("line_total") @db.Decimal(14, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// DML audit — filled only by triggers (never by the API).
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()::text"))
  tableName  String   @map("tabela")
  recordId   String?  @map("registro_id")
  operation  String   @map("operacao")
  dataBefore Json?    @map("dados_antes")
  dataAfter  Json?    @map("dados_depois")
  dbUser     String   @default(dbgenerated("CURRENT_USER")) @map("usuario_db")
  appUser    String?  @map("app_usuario")
  createdAt  DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@index([tableName, createdAt(sort: Desc)], map: "audit_log_tabela_criado_idx")
  @@index([recordId], map: "audit_log_registro_idx")
  @@map("audit_log")
}
